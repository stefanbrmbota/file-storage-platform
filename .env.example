# Šablon za docker compose (US-33, T-33.2).
# Kopiraj u .env u root-u repoa; .env se ne commituje.
# Ovde su samo vrednosti koje deli više kontejnera; ostalo je u <servis>/.env.
# Bez .env compose koristi iste "change-me" vrednosti (samo za lokalni razvoj).

# Port gateway-a na hostu.
GATEWAY_PUBLIC_PORT=8080

# Ista tajna za Users (potpis) i gateway (provera). Min. 32 karaktera.
JWT_SECRET=change-me-jwt-secret-at-least-32-chars

# Ista tajna za interne pozive izmedju servisa (X-Internal-Token): Users je proverava,
# Files je salje pri rezervaciji kvote. Min. 32 karaktera.
INTERNAL_TOKEN=change-me-internal-token-at-least-32-chars

# MinIO nalog; Files ga koristi kao MINIO_ACCESS_KEY / MINIO_SECRET_KEY. Lozinka min. 8 karaktera.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-minio

# Neo4j lozinka; Sharing je koristi kao SHARING_NEO4J_PASSWORD. Min. 8 karaktera.
NEO4J_PASSWORD=change-me-neo4j
