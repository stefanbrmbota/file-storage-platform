# Šablon konfiguracije Analytics servisa (US-31).
# Kopiraj u .env pored ovog fajla i popuni vrednosti; .env se ne commituje.

# Server.
ANALYTICS_PORT=8085

# Cassandra (design 4). Adrese čvorova odvojene zarezom.
ANALYTICS_CASSANDRA_HOSTS=localhost:9042
ANALYTICS_CASSANDRA_KEYSPACE=analytics
# Lokalno 1; u K8s okruženju 3.
ANALYTICS_CASSANDRA_REPLICATION_FACTOR=1

# Files servis (S5: vlasnik datoteke) i timeout za pozive drugih servisa.
FILES_SERVICE_URL=http://localhost:8082
ANALYTICS_REQUEST_TIMEOUT=5s

# Broker: promenljive se dodaju kad se broker izabere (design O9).
