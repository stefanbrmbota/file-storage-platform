# Argon2id parametri za heširanje lozinki (paket internal/password).
# Ako promenljiva nije postavljena, koristi se vrednost navedena ovde.
ARGON2_MEMORY_KB=65536
ARGON2_TIME=3
ARGON2_THREADS=2
ARGON2_SALT_LEN=16
ARGON2_KEY_LEN=32

# Server i baza.
USERS_PORT=8081
USERS_MONGO_URI=mongodb://localhost:27017
USERS_MONGO_DB=users

# Podrazumevana kvota novog naloga u bajtovima (1 GiB).
USERS_DEFAULT_QUOTA_BYTES=1073741824

# Potvrda registracije mejlom (US-04). Za razvoj MailHog: SMTP 1025, UI na http://localhost:8025.
# SMTP_USER i SMTP_PASSWORD se postavljaju zajedno i samo za pravi SMTP server.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@file-storage.local
#SMTP_USER=
#SMTP_PASSWORD=
# Klijentska stranica za potvrdu; token se dodaje kao #token=... (fragment, ne ide u logove servera).
CONFIRM_URL_BASE=http://localhost:3000/confirm
# Rok vazenja linka za potvrdu.
CONFIRMATION_TTL=24h
# Files servis (kreira korenski folder pri potvrdi) i timeout za pozive ka drugim servisima.
FILES_SERVICE_URL=http://localhost:8082
USERS_REQUEST_TIMEOUT=5s

# Inicijalni admin nalog (US-24). Kreira se pri startu ako ne postoji.
# Oba moraju biti postavljena zajedno; lozinku promeniti u pravom okruzenju.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
