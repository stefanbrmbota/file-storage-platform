# Argon2id parametri za heširanje lozinki (paket internal/password).
# Ako promenljiva nije postavljena, koristi se vrednost navedena ovde.
ARGON2_MEMORY_KB=65536
ARGON2_TIME=3
ARGON2_THREADS=2
ARGON2_SALT_LEN=16
ARGON2_KEY_LEN=32

# Server i baza.
USERS_PORT=8081
USERS_MONGO_URI=mongodb://localhost:27017
USERS_MONGO_DB=users

# Podrazumevana kvota novog naloga u bajtovima (1 GiB).
USERS_DEFAULT_QUOTA_BYTES=1073741824

# Potvrda registracije mejlom (US-04). Za razvoj MailHog: SMTP 1025, UI na http://localhost:8025.
# SMTP_USER i SMTP_PASSWORD se postavljaju zajedno i samo za pravi SMTP server.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@file-storage.local
#SMTP_USER=
#SMTP_PASSWORD=
# Klijentska stranica za potvrdu; token se dodaje kao #token=... (fragment, ne ide u logove servera).
CONFIRM_URL_BASE=http://localhost:3000/potvrda
# Rok vazenja linka za potvrdu.
CONFIRMATION_TTL=24h
# Files servis (kreira korenski folder pri potvrdi) i timeout za pozive ka drugim servisima.
FILES_SERVICE_URL=http://localhost:8082
USERS_REQUEST_TIMEOUT=5s

# OTP (US-05). Tajna za HMAC koda (min. 16 karaktera, u pravom okruzenju zameniti) i rok vazenja.
OTP_HMAC_SECRET=change-me-otp-secret-please
OTP_TTL=5m
# Najveci broj pokusaja unosa OTP-a; posle toga se OTP brise i treba ponovo proci /login.
OTP_MAX_ATTEMPTS=5

# JWT (US-05). Tajna za potpis tokena (min. 32 karaktera, u pravom okruzenju zameniti) i rok vazenja.
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
JWT_TTL=15m

# Promena lozinke (US-14). Najkrace vreme od poslednje promene lozinke do sledece;
# specifikacija trazi najmanje 1 dan. Za demonstraciju se moze skratiti (npr. 1m).
# Pazi: lozinka tek registrovanog naloga se racuna kao "promenjena" pri registraciji.
PASSWORD_MIN_AGE=24h

# Istek lozinke (US-16). Najduze vreme vazenja lozinke; posle toga je prijava onemogucena
# dok se lozinka ne promeni resetom mejlom (US-15). Specifikacija: najvise 60 dana (1440h;
# Go trajanje nema oznaku za dane). Mora biti duze od PASSWORD_MIN_AGE. Za demonstraciju
# se moze skratiti (npr. 2m).
PASSWORD_MAX_AGE=1440h

# Reset lozinke putem mejla (US-15). Klijentska stranica na koju vodi link (token se dodaje
# kao #token=..., fragment ne ide u logove servera), rok vazenja linka i najkrace vreme
# izmedju dva mejla za reset istom korisniku (zastita od zasipanja mejlovima).
RESET_URL_BASE=http://localhost:3000/reset-lozinke
PASSWORD_RESET_TTL=15m
PASSWORD_RESET_COOLDOWN=1m

# Interni pozivi izmedju servisa (US-20). Ista tajna kod pozivaoca (zaglavlje X-Internal-Token).
# Min. 32 karaktera, u pravom okruzenju zameniti; servis se ne podize bez nje.
INTERNAL_TOKEN=change-me-internal-token-at-least-32-chars

# Inicijalni admin nalog (US-24). Kreira se pri startu ako ne postoji.
# Oba moraju biti postavljena zajedno; lozinku promeniti u pravom okruzenju.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
