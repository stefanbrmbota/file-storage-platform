# Šablon konfiguracije Sharing servisa (US-31).
# Kopiraj u .env pored ovog fajla i popuni vrednosti; .env se ne commituje.
# Vrednosti "change-me" obavezno zameni van lokalnog razvoja.

# Server.
SHARING_PORT=8084

# Neo4j.
SHARING_NEO4J_URI=bolt://localhost:7687
SHARING_NEO4J_USER=neo4j
SHARING_NEO4J_PASSWORD=change-me

# Users servis (S4: pronalaženje korisnika po mejlu) i timeout za pozive drugih servisa.
USERS_SERVICE_URL=http://localhost:8081
SHARING_REQUEST_TIMEOUT=5s

# Broker: promenljive se dodaju kad se broker izabere (design O9).
