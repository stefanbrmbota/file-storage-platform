# Šablon konfiguracije Notifications servisa (US-31).
# Kopiraj u .env pored ovog fajla i popuni vrednosti; .env se ne commituje.

# Server.
NOTIFICATIONS_PORT=8083

# Cassandra (design 3.2). Adrese čvorova odvojene zarezom.
NOTIFICATIONS_CASSANDRA_HOSTS=localhost:9042
NOTIFICATIONS_CASSANDRA_KEYSPACE=notifications
# Lokalno 1; u K8s okruženju 3.
NOTIFICATIONS_CASSANDRA_REPLICATION_FACTOR=1
# Najduže čekanje na jedan upit ka bazi.
NOTIFICATIONS_CASSANDRA_TIMEOUT=5s
# Koliko dugo servis pri pokretanju pokušava da se poveže (Cassandra se sporo podiže).
NOTIFICATIONS_CASSANDRA_STARTUP_TIMEOUT=60s

# Broker: promenljive se dodaju kad se broker izabere (design O9).
