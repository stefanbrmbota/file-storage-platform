# Šablon konfiguracije API gateway-a (US-31).
# Kopiraj u .env pored ovog fajla i popuni vrednosti; .env se ne commituje.
# Vrednosti "change-me" obavezno zameni van lokalnog razvoja.

# Server. Gateway je jedina ulazna tačka spolja.
GATEWAY_PORT=8080

# JWT (design 5.3). Ista tajna kao JWT_SECRET u Users servisu (min. 32 karaktera).
JWT_SECRET=change-me-jwt-secret-at-least-32-chars

# Timeout za prosleđivanje zahteva servisima (design 5.3).
GATEWAY_UPSTREAM_TIMEOUT=10s
# Timeout za proveru opozvanog tokena u Users servisu (S6, T-30.5).
GATEWAY_AUTH_TIMEOUT=5s

# Adrese servisa u internoj mreži (design 5.3, tačka 6).
USERS_SERVICE_URL=http://localhost:8081
FILES_SERVICE_URL=http://localhost:8082
NOTIFICATIONS_SERVICE_URL=http://localhost:8083
SHARING_SERVICE_URL=http://localhost:8084
ANALYTICS_SERVICE_URL=http://localhost:8085

# CORS (T-30.3): origin-i klijentske aplikacije, razdvojeni zarezom, bez *.
CORS_ALLOWED_ORIGINS=http://localhost:3000
